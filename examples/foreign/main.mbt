///|
/// Original corpus generated by pympi-ling 1.70.2; optional TIME_VALUE omitted
/// independently with Python ElementTree. No upstream implementation copied.
fn main raise {
  let xml =
    #|<ANNOTATION_DOCUMENT xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" AUTHOR="pympi" DATE="2026-11-23T00:00:00Z" VERSION="2.8" FORMAT="2.8" xsi:noNamespaceSchemaLocation="http://www.mpi.nl/tools/elan/EAFv2.8.xsd">
    #|	<LICENSE LICENSE_URL="https://example.org/license">Synthetic test data</LICENSE>
    #|	<HEADER>
    #|		<MEDIA_DESCRIPTOR MEDIA_URL="file:///metadata.txt" MIME_TYPE="text/plain" />
    #|		<PROPERTY NAME="lastUsedAnnotation">0</PROPERTY>
    #|		</HEADER>
    #|	<TIME_ORDER>
    #|		<TIME_SLOT TIME_SLOT_ID="ts2" />
    #|		<TIME_SLOT TIME_SLOT_ID="ts3" TIME_VALUE="1000" />
    #|		</TIME_ORDER>
    #|	<TIER TIER_ID="default" LINGUISTIC_TYPE_REF="default-lt" />
    #|	<TIER TIER_ID="review tier" LINGUISTIC_TYPE_REF="review">
    #|		<ANNOTATION>
    #|			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a2" TIME_SLOT_REF1="ts2" TIME_SLOT_REF2="ts3">
    #|				<ANNOTATION_VALUE>pending</ANNOTATION_VALUE>
    #|				</ALIGNABLE_ANNOTATION>
    #|			</ANNOTATION>
    #|		</TIER>
    #|	<LINGUISTIC_TYPE LINGUISTIC_TYPE_ID="default-lt" TIME_ALIGNABLE="true" GRAPHIC_REFERENCES="false" />
    #|	<LINGUISTIC_TYPE LINGUISTIC_TYPE_ID="review" TIME_ALIGNABLE="true" GRAPHIC_REFERENCES="false" CONTROLLED_VOCABULARY_REF="status" />
    #|	<LOCALE LANGUAGE_CODE="en" COUNTRY_CODE="GB" />
    #|	<LANGUAGE LANG_ID="eng" LANG_LABEL="English" />
    #|	<LANGUAGE LANG_ID="zho" LANG_LABEL="中文" />
    #|	<CONSTRAINT STEREOTYPE="Time_Subdivision" DESCRIPTION="Time subdivision of parent annotation's time interval, no time gaps allowed within this interval" />
    #|	<CONSTRAINT STEREOTYPE="Symbolic_Subdivision" DESCRIPTION="Symbolic subdivision of a parent annotation. Annotations refering to the same parent are ordered" />
    #|	<CONSTRAINT STEREOTYPE="Symbolic_Association" DESCRIPTION="1-1 association with a parent annotation" />
    #|	<CONSTRAINT STEREOTYPE="Included_In" DESCRIPTION="Time alignable annotations within the parent annotation's time interval, gaps are allowed" />
    #|	<CONTROLLED_VOCABULARY CV_ID="status">
    #|		<DESCRIPTION LANG_REF="eng">Review status</DESCRIPTION>
    #|		<CV_ENTRY_ML CVE_ID="todo">
    #|			<CVE_VALUE LANG_REF="eng" DESCRIPTION="waiting">pending</CVE_VALUE>
    #|			<CVE_VALUE LANG_REF="zho" DESCRIPTION="等待">待定</CVE_VALUE>
    #|			</CV_ENTRY_ML>
    #|		<CV_ENTRY_ML CVE_ID="done">
    #|			<CVE_VALUE LANG_REF="eng" DESCRIPTION="done">complete</CVE_VALUE>
    #|			<CVE_VALUE LANG_REF="zho" DESCRIPTION="已完成">完成</CVE_VALUE>
    #|			</CV_ENTRY_ML>
    #|		</CONTROLLED_VOCABULARY>
    #|	</ANNOTATION_DOCUMENT>

  let d = @eaf.parse(xml)
  assert_eq(d.times[0].milliseconds, None)
  assert_eq(@eaf.vocabulary_choices(d, "review tier", "zho").length(), 2)
  let id = @eaf.annotation_id(d.tiers[d.tiers.length() - 1].annotations[0])
  let d = @eaf.set_controlled_value(d, id, "done", "zho")
  assert_eq(
    @eaf.annotation_value(d.tiers[d.tiers.length() - 1].annotations[0]),
    "完成",
  )
  assert_eq(@eaf.write(@eaf.parse(@eaf.write(d))), @eaf.write(d))
  println(@eaf.write(d))
}
